  year      = {2011},
  abstract  = {Praxisnahes Handbuch zur Planung und F{\"u}hrung qualitativer
               Interviews. Helfferich versteht das Interview als
               Kommunikationssituation, in der die Daten gemeinsam hervorgebracht
               werden, und fordert deshalb Reflexion statt vermeintlicher
               Neutralit{\"a}t. Bekannt ist ihr SPSS-Prinzip zur Leitfadenerstellung:
               Fragen Sammeln, Pr{\"u}fen, Sortieren und Subsumieren. Das Buch
               behandelt au{\ss}erdem offene versus suggestive Fragen,
               Aufrechterhaltungs- und Nachfragen sowie Transkription. F{\"u}r das
               Skript: Grundlage der Leitfadenvorlage in LE~9.}
}

@article{hicks2015leiden,
  author   = {Hicks, Diana and Wouters, Paul and Waltman, Ludo and de Rijcke, Sarah and Rafols, Ismael},
  title    = {Bibliometrics: The {Leiden} Manifesto for Research Metrics},
  journal  = {Nature},
  volume   = {520},
  number   = {7548},
  pages    = {429--431},
  year     = {2015},
  doi      = {10.1038/520429a},
  abstract = {Zehn Grunds{\"a}tze f{\"u}r den verantwortlichen Gebrauch von
              Forschungsmetriken. Kernaussagen: Quantitative Kennzahlen sollen
              qualitative Expertenurteile unterst{\"u}tzen, nicht ersetzen;
              Unterschiede zwischen Fachkulturen sind zu ber{\"u}cksichtigen;
              falsche Pr{\"a}zision ist zu vermeiden; Indikatoren ver{\"a}ndern
              das System, das sie messen sollen, und sind deshalb regelm{\"a}{\ss}ig
              zu {\"u}berpr{\"u}fen.}
}

@article{hirsch2005index,
  author   = {Hirsch, Jorge E.},
  title    = {An Index to Quantify an Individual's Scientific Research Output},
  journal  = {Proceedings of the National Academy of Sciences},
  volume   = {102},
  number   = {46},
  pages    = {16569--16572},
  year     = {2005},
  doi      = {10.1073/pnas.0507655102},
  abstract = {Hirsch schl{\"a}gt den sp{\"a}ter nach ihm benannten h-Index vor:
              Eine Person hat den Index $h$, wenn $h$ ihrer Arbeiten jeweils
              mindestens $h$-mal zitiert wurden. Die Kennzahl soll Umfang und
              Wirkung eines Forschungswerks in einer Zahl b{\"u}ndeln. Der
              Aufsatz diskutiert selbst bereits Grenzen, etwa die Abh{\"a}ngigkeit
              von Fachkultur und Karrierel{\"a}nge. F{\"u}r das Skript der
              Ausgangspunkt der Frage, was Zitationsmetriken messen und was
              nicht.}
}

@book{hulley2013designing,
  author    = {Hulley, Stephen B. and Cummings, Steven R. and Browner, Warren S. and Grady, Deborah G. and Newman, Thomas B.},
  title     = {Designing Clinical Research},
  edition   = {4},
  publisher = {Lippincott Williams \& Wilkins},
  address   = {Philadelphia},
  year      = {2013},
  abstract  = {Lehrbuch zur Planung klinischer und epidemiologischer Studien. Bekannt ist es unter anderem f{\"u}r die FINER-Kriterien einer guten Forschungsfrage: durchf{\"u}hrbar (feasible), interessant, neu (novel), ethisch vertretbar und relevant. Weitere Kapitel behandeln Stichprobe, Messung, Designs und Studienprotokoll.}
}

@article{kerr1998harking,
  author  = {Kerr, Norbert L.},
  title   = {{HARKing}: Hypothesizing After the Results are Known},
  journal = {Personality and Social Psychology Review},
  volume  = {2},
  number  = {3},
  pages   = {196--217},
  year    = {1998},
  doi     = {10.1207/s15327957pspr0203_4},
  abstract = {Kerr pr{\"a}gt den Begriff HARKing: Eine Hypothese, die erst nach
              Sichtung der Ergebnisse gebildet wurde, wird im Bericht so
              dargestellt, als sei sie vorab aufgestellt worden. Er beschreibt
              Spielarten der Praxis, ihre Verbreitung und ihre Kosten: Zufallsbefunde
              werden als best{\"a}tigte Theorie ausgegeben, widerlegte Hypothesen
              verschwinden aus der Literatur, und Leserinnen und Leser k{\"o}nnen den
              Beweiswert eines Befundes nicht mehr einsch{\"a}tzen. F{\"u}r das Skript:
              HARKing als Fehlerquelle der Interpretation in LE~10.}
}

@incollection{lagarias2009kruskal,
  author    = {Lagarias, Jeffrey C. and Rains, Eric and Vanderbei, Robert J.},
  title     = {The {Kruskal} Count},
  booktitle = {The Mathematics of Preference, Choice and Order: Essays in Honor of Peter C. Fishburn},
  editor    = {Brams, Steven J. and Gehrlein, William V. and Roberts, Fred S.},
  publisher = {Springer},
  address   = {Berlin, Heidelberg},
  pages     = {371--391},
  year      = {2009},
  abstract  = {Mathematische Analyse des Kartentricks, den Martin Kruskal in den 1970er-Jahren beschrieb: Zwei Personen folgen unabh{\"a}ngig von verschiedenen Startpunkten einer Z{\"a}hlregel durch ein Kartenspiel und landen mit hoher Wahrscheinlichkeit auf derselben Schlusskarte. Die Autoren modellieren das Verfahren als Kopplung von Markov-Ketten, sch{\"a}tzen die Erfolgswahrscheinlichkeit ab und zeichnen die Geschichte des Effekts nach, der durch Martin Gardner bekannt wurde.}
}

@book{lincolnguba1985naturalistic,
  author    = {Lincoln, Yvonna S. and Guba, Egon G.},
  title     = {Naturalistic Inquiry},
  publisher = {Sage},
  address   = {Beverly Hills, CA},
  year      = {1985},
  abstract  = {Grundlegende Methodologie qualitativ-naturalistischer Forschung.
               Lincoln und Guba setzen den Kriterien quantitativer Forschung
               (interne und externe Validit{\"a}t, Reliabilit{\"a}t, Objektivit{\"a}t)
               vier Entsprechungen f{\"u}r interpretative Studien entgegen:
               Credibility (Glaubw{\"u}rdigkeit, etwa durch l{\"a}ngeres Feldengagement,
               Triangulation und member checking), Transferability ({\"U}bertragbarkeit
               durch dichte Beschreibung), Dependability (Zuverl{\"a}ssigkeit durch
               nachvollziehbare Dokumentation) und Confirmability (Best{\"a}tigbarkeit
               durch einen Audit Trail). F{\"u}r das Skript: Quelle der G{\"u}tekriterien
               in LE~9.}
}

@article{loftus1974reconstruction,
  author   = {Loftus, Elizabeth F. and Palmer, John C.},
  title    = {Reconstruction of Automobile Destruction: An Example of the Interaction Between Language and Memory},
  journal  = {Journal of Verbal Learning and Verbal Behavior},
  volume   = {13},
  number   = {5},
  pages    = {585--589},
  year     = {1974},
  abstract = {Versuchspersonen sahen Filme von Autounf{\"a}llen und sch{\"a}tzten danach die Geschwindigkeit. Wurde in der Frage ein st{\"a}rkeres Verb verwendet (smashed statt hit), fielen die Sch{\"a}tzungen h{\"o}her aus, und eine Woche sp{\"a}ter berichteten mehr Personen von zerbrochenem Glas, das im Film nicht zu sehen war. Die Studie zeigt, dass die Formulierung einer Frage Antworten und Erinnerung ver{\"a}ndert.}
}

@article{loftuspalmer1974,
  author  = {Loftus, Elizabeth F. and Palmer, John C.},
  title   = {Reconstruction of Automobile Destruction: An Example of the
             Interaction Between Language and Memory},
  journal = {Journal of Verbal Learning and Verbal Behavior},
  volume  = {13},
  number  = {5},
  pages   = {585--589},
  year    = {1974},
  doi     = {10.1016/S0022-5371(74)80011-3},
  abstract = {Klassisches Experiment zur Wirkung der Frageformulierung.
              Versuchspersonen sahen Filme von Autounf{\"a}llen und sch{\"a}tzten
              anschlie{\ss}end die Geschwindigkeit. Wurde im Fragetext das Verb
              \enquote{smashed} statt \enquote{hit} verwendet, fielen die
              Sch{\"a}tzungen h{\"o}her aus, und eine Woche sp{\"a}ter berichteten
              mehr Personen von zerbrochenem Glas, das im Film nicht vorkam. Die
              Formulierung einer Frage ver{\"a}ndert also nicht nur die Antwort,
              sondern auch die Erinnerung. F{\"u}r das Skript: Beleg in LE~9, dass
              Interviewsprache die erhobene Wirklichkeit mitformt.}
}

@book{mayer2009multimedia,
  author    = {Mayer, Richard E.},
  title     = {Multimedia Learning},
  edition   = {2},
  publisher = {Cambridge University Press},
  address   = {New York},
  year      = {2009},
  abstract  = {Zusammenfassung des Forschungsprogramms zum Lernen mit Wort und
               Bild. Mayer leitet aus Experimenten Gestaltungsprinzipien ab,
               u.\,a.\ Koh{\"a}renz (Unwesentliches weglassen), Signalisierung
               (Wesentliches hervorheben), Redundanz (gesprochenen Text nicht
               zus{\"a}tzlich vollst{\"a}ndig einblenden), r{\"a}umliche und zeitliche
               N{\"a}he von Wort und Bild sowie Segmentierung. F{\"u}r LE~12:
               Kriterien der Folienkritik.}
}

@book{mayring2015inhaltsanalyse,
  author    = {Mayring, Philipp},
  title     = {Qualitative Inhaltsanalyse. Grundlagen und Techniken},
  edition   = {12},
  publisher = {Beltz},
  address   = {Weinheim und Basel},
  year      = {2015},
  abstract  = {Standardwerk zur qualitativen Inhaltsanalyse im deutschsprachigen
               Raum. Mayring beschreibt ein regelgeleitetes Verfahren, sprachliches
               Material (Interviews, Dokumente) schrittweise in ein Kategoriensystem
               zu {\"u}berf{\"u}hren. Die drei Grundformen sind Zusammenfassung
               (induktive Kategorienbildung am Material), Explikation (Kontextanalyse
               unklarer Stellen) und Strukturierung (deduktive Anwendung vorab
               definierter Kategorien mit Definition, Ankerbeispiel und
               Kodierregel). G{\"u}te wird {\"u}ber Regelgeleitetheit,
               Nachvollziehbarkeit und Intercoder-{\"U}bereinstimmung gesichert.
               F{\"u}r das Skript: Grundlage des Codier-Vergleichs in LE~9.}
}

@article{merton1968matthew,
  author   = {Merton, Robert K.},
  title    = {The {Matthew} Effect in Science},
  journal  = {Science},
  volume   = {159},
  number   = {3810},
  pages    = {56--63},
  year     = {1968},
  doi      = {10.1126/science.159.3810.56},
  abstract = {Merton beschreibt, dass bereits bekannte Forschende f{\"u}r
              vergleichbare Beitr{\"a}ge mehr Anerkennung erhalten als
              unbekannte (\enquote{Wer hat, dem wird gegeben}). Der Effekt
              verst{\"a}rkt sich selbst und pr{\"a}gt, wessen Arbeiten gelesen
              und zitiert werden. F{\"u}r die Quellenkritik folgt daraus, dass
              Zitationszahlen auch Sichtbarkeit und Reputation abbilden, nicht
              nur Qualit{\"a}t.}
}

@article{nosek2018preregistration,
  author  = {Nosek, Brian A. and Ebersole, Charles R. and DeHaven, Alexander C.
             and Mellor, David T.},
  title   = {The Preregistration Revolution},
  journal = {Proceedings of the National Academy of Sciences},
  volume  = {115},
  number  = {11},
  pages   = {2600--2606},
  year    = {2018},
  doi     = {10.1073/pnas.1708274114},
  abstract = {Die Autoren unterscheiden zwei Modi der Forschung: Vorhersage
              (Hypothesen pr{\"u}fen) und Nachhersage (Hypothesen aus den Daten
              gewinnen). Beide sind legitim, werden aber h{\"a}ufig verwechselt, was
              die Aussagekraft statistischer Tests untergr{\"a}bt. Pr{\"a}registrierung,
              also das Festlegen von Hypothesen und Auswertungsplan vor der
              Datensichtung, macht sichtbar, welcher Modus vorliegt. Der Beitrag
              diskutiert Einw{\"a}nde und praktische Umsetzung. F{\"u}r das Skript:
              Pr{\"a}registrierung als Gegenmittel in LE~10.}
}

@article{oppenheimer2006erudite,
  author  = {Oppenheimer, Daniel M.},
  title   = {Consequences of Erudite Vernacular Utilized Irrespective of
             Necessity: Problems with Using Long Words Needlessly},
  journal = {Applied Cognitive Psychology},
  volume  = {20},
  number  = {2},
  pages   = {139--156},
  year    = {2006},
  doi     = {10.1002/acp.1178},
  abstract = {F{\"u}nf Experimente zur Wirkung komplizierter Sprache. Texte, in
              denen W{\"o}rter durch l{\"a}ngere Synonyme ersetzt wurden, f{\"u}hrten
              dazu, dass Leserinnen und Leser die Verfasser als weniger
              intelligent einsch{\"a}tzten; erkl{\"a}rt wird der Befund mit der
              geringeren Verarbeitungsfl{\"u}ssigkeit. Der Effekt verschwand,
              wenn die Schwierigkeit einer anderen Ursache zugeschrieben werden
              konnte. F{\"u}r LE~11: empirischer Beleg gegen Imponiervokabular.}
}

@article{page2021prisma,
  author   = {Page, Matthew J. and McKenzie, Joanne E. and Bossuyt, Patrick M. and Boutron, Isabelle and Hoffmann, Tammy C. and Mulrow, Cynthia D. and others},
  title    = {The {PRISMA} 2020 Statement: An Updated Guideline for Reporting Systematic Reviews},
  journal  = {BMJ},
  volume   = {372},
  pages    = {n71},
  year     = {2021},
  doi      = {10.1136/bmj.n71},
  abstract = {Aktualisierte Berichtsleitlinie f{\"u}r systematische {\"U}bersichtsarbeiten. Sie enth{\"a}lt eine Checkliste und ein Flussdiagramm, das dokumentiert, wie viele Datens{\"a}tze in welchen Quellen gefunden, aussortiert und schlie{\ss}lich eingeschlossen wurden. Ziel ist, dass Leserinnen und Leser die Suche und Auswahl nachvollziehen und wiederholen k{\"o}nnen.}
}

@book{paivio1986mental,
  author    = {Paivio, Allan},
  title     = {Mental Representations: A Dual Coding Approach},
  publisher = {Oxford University Press},
  address   = {New York},
  year      = {1986},
  abstract  = {Ausf{\"u}hrliche Darstellung der Dual-Coding-Theorie: Das
               kognitive System verarbeitet sprachliche und bildhafte
               Information in zwei getrennten, aber verbundenen
               Repr{\"a}sentationssystemen. Information, die in beiden Systemen
               kodiert ist, wird besser behalten. F{\"u}r LE~12: Grundlage f{\"u}r die
               Kombination von gesprochenem Wort und Bild auf Folien.}
}

@book{pfungst1907,
  author    = {Pfungst, Oskar},
  title     = {Das Pferd des Herrn von Osten (Der Kluge Hans): Ein Beitrag zur experimentellen Tier- und Menschen-Psychologie},
  publisher = {Johann Ambrosius Barth},
  address   = {Leipzig},
  year      = {1907},
  abstract  = {Untersuchung des Pferdes \enquote{Kluger Hans}, das angeblich rechnen
               konnte und Antworten durch Hufschl{\"a}ge gab. Pfungst zeigte mit
               systematisch variierten Bedingungen, dass das Pferd nur dann
               richtig antwortete, wenn die fragende Person die Antwort kannte
               und f{\"u}r das Tier sichtbar war: Es reagierte auf unwillk{\"u}rliche,
               minimale Bewegungen der Fragenden. Die Arbeit ist ein fr{\"u}hes
               Lehrst{\"u}ck f{\"u}r Versuchsleitereffekte und f{\"u}r den Wert von
               Blindbedingungen.}
}

@article{quine1951dogmas,
  author   = {Quine, Willard Van Orman},
  title    = {Two Dogmas of Empiricism},
  journal  = {The Philosophical Review},
  volume   = {60},
  number   = {1},
  pages    = {20--43},
  year     = {1951},
  abstract = {Quine kritisiert zwei Grundannahmen des logischen Empirismus: die
              scharfe Trennung analytischer und synthetischer Aussagen und den
              Reduktionismus, nach dem jede sinnvolle Aussage einzeln auf
              Erfahrung zur{\"u}ckf{\"u}hrbar sei. Stattdessen stehe unser Wissen als
              Ganzes vor dem Tribunal der Erfahrung; ein widerspenstiger Befund
              erzwinge Anpassungen irgendwo im Netz der {\"U}berzeugungen, ohne
              festzulegen, wo. Zusammen mit Duhems These {\"u}ber die Pr{\"u}fung
              physikalischer Hypothesen als Duhem-Quine-These bekannt: Eine
              Hypothese wird nie isoliert, sondern nur zusammen mit
              Hilfsannahmen gepr{\"u}ft.}
}

@article{reber1999fluency,
  author  = {Reber, Rolf and Schwarz, Norbert},
  title   = {Effects of Perceptual Fluency on Judgments of Truth},
  journal = {Consciousness and Cognition},
  volume  = {8},
  number  = {3},
  pages   = {338--342},
  year    = {1999},
  doi     = {10.1006/ccog.1999.0386},
  abstract = {Aussagen der Form \enquote{Stadt X liegt in Land Y} wurden in
              unterschiedlich gut lesbaren Farbkontrasten dargeboten. Leicht
              lesbare Aussagen wurden h{\"a}ufiger als wahr beurteilt als schwer
              lesbare. Wahrnehmungsfl{\"u}ssigkeit wirkt also als Hinweisreiz f{\"u}r
              Wahrheit, unabh{\"a}ngig vom Inhalt. F{\"u}r LE~12: Gestaltung und
              Vortragsfluss k{\"o}nnen Glaubw{\"u}rdigkeit erzeugen, die nicht vom
              Inhalt gedeckt ist.}
}

@article{rosenthal1963experimenter,
  author   = {Rosenthal, Robert and Fode, Kermit L.},
  title    = {The Effect of Experimenter Bias on the Performance of the Albino Rat},
  journal  = {Behavioral Science},
  volume   = {8},
  number   = {3},
  pages    = {183--189},
  year     = {1963},
  abstract = {Studierende trainierten Ratten im Labyrinth. Einem Teil wurde gesagt,
              ihre Tiere seien auf Labyrinthklugheit gez{\"u}chtet, dem anderen
              Teil, sie seien labyrinthdumm; tats{\"a}chlich waren die Tiere
              zuf{\"a}llig zugeteilt. Die angeblich klugen Ratten zeigten bessere
              Leistungen. Die Studie gilt als klassischer Beleg f{\"u}r den
              Versuchsleitereffekt (experimenter expectancy effect): Erwartungen
              der Forschenden beeinflussen die Daten, auch ohne bewusste
              Manipulation. Sie begr{\"u}ndet die Forderung nach
              Blindbedingungen bei der Datenerhebung.}
}

@article{rosenthal1979filedrawer,
  author   = {Rosenthal, Robert},
  title    = {The {\enquote{File Drawer Problem}} and Tolerance for Null Results},
  journal  = {Psychological Bulletin},
  volume   = {86},
  number   = {3},
  pages    = {638--641},
  year     = {1979},
  abstract = {Rosenthal benennt das Schubladenproblem: Studien ohne signifikantes
              Ergebnis werden seltener eingereicht und ver{\"o}ffentlicht und
              verschwinden in der Schublade. Die publizierte Literatur
              {\"u}bersch{\"a}tzt dadurch systematisch Effekte. Er schl{\"a}gt ein Ma{\ss}
              daf{\"u}r vor, wie viele unver{\"o}ffentlichte Nullbefunde n{\"o}tig w{\"a}ren,
              um einen Gesamtbefund aufzuheben (fail-safe N), und begr{\"u}ndet
              damit die Diskussion um den Publikationsbias.}
}

@article{seglen1997impact,
  author   = {Seglen, Per O.},
  title    = {Why the Impact Factor of Journals Should Not Be Used for Evaluating Research},
  journal  = {BMJ},
  volume   = {314},
  number   = {7079},
  pages    = {497},
  year     = {1997},
  doi      = {10.1136/bmj.314.7079.497},
  abstract = {Seglen zeigt, dass der Impact Factor einer Zeitschrift wenig
              {\"u}ber den einzelnen darin erschienenen Artikel aussagt: Die
              Zitationen innerhalb einer Zeitschrift sind stark schief verteilt,
              eine kleine Zahl von Artikeln tr{\"a}gt den Gro{\ss}teil der
              Zitate. Hinzu kommen Unterschiede zwischen Fachgebieten,
              Verzerrungen durch Artikeltypen und Selbstzitate. Der Beitrag ist
              eine der meistzitierten Warnungen vor dem Gebrauch des Impact
              Factors zur Bewertung von Personen und Einzelarbeiten.}
}

@book{shadish2002experimental,
  author    = {Shadish, William R. and Cook, Thomas D. and Campbell, Donald T.},
  title     = {Experimental and Quasi-Experimental Designs for Generalized Causal Inference},
  publisher = {Houghton Mifflin},
  address   = {Boston},
  year      = {2002},
  abstract  = {Standardwerk zur Planung experimenteller und quasi-experimenteller
               Studien. Die Autoren systematisieren vier Validit{\"a}tsarten
               (statistische Schlussvalidit{\"a}t, interne, Konstrukt- und externe
               Validit{\"a}t) und die typischen Bedrohungen der internen
               Validit{\"a}t wie Geschichte, Reifung, Testeffekte, Instrumentierung,
               Regression zur Mitte, Selektion und Ausfall. Sie zeigen, wie
               Kontrollgruppen, Zufallszuteilung, Vortests und wiederholte
               Messungen diese Bedrohungen ausschlie{\ss}en oder absch{\"a}tzen
               lassen, und behandeln die Verallgemeinerung kausaler Befunde {\"u}ber
               Personen, Situationen und Zeitpunkte hinweg.}
}

@book{swales1990genre,
  author    = {Swales, John M.},
  title     = {Genre Analysis: English in Academic and Research Settings},
  publisher = {Cambridge University Press},
  address   = {Cambridge},
  year      = {1990},
  abstract  = {Grundlegende Studie zur Gattungsanalyse wissenschaftlicher
               Texte. Swales beschreibt Fachtextsorten als kommunikative
               Handlungen einer Diskursgemeinschaft und entwickelt f{\"u}r
               Einleitungen von Forschungsartikeln das CARS-Modell (Create a
               Research Space) mit drei Z{\"u}gen: ein Forschungsfeld abstecken,
               eine Nische (L{\"u}cke) aufzeigen, die Nische mit der eigenen
               Arbeit besetzen. Grundlage des Vierschritts Thema--L{\"u}cke--Frage--Aufbau
               in LE~11.}
}

@article{sweller1988cognitive,
  author  = {Sweller, John},
  title   = {Cognitive Load During Problem Solving: Effects on Learning},
  journal = {Cognitive Science},
  volume  = {12},
  number  = {2},
  pages   = {257--285},
  year    = {1988},
  doi     = {10.1207/s15516709cog1202_4},
  abstract = {Ausgangsarbeit der Cognitive-Load-Theorie. Sweller argumentiert,
              dass Probleml{\"o}sen mit Mittel-Ziel-Analyse das begrenzte
              Arbeitsged{\"a}chtnis so stark beansprucht, dass f{\"u}r den Aufbau von
              Schemata wenig Kapazit{\"a}t bleibt; Lernmaterial sollte daher
              unn{\"o}tige Belastung vermeiden. F{\"u}r LE~12: theoretische
              Grundlage daf{\"u}r, Folien von allem zu befreien, was das
              Arbeitsged{\"a}chtnis ohne Nutzen belastet.}
}

@book{toulmin1958uses,
  author    = {Toulmin, Stephen E.},
  title     = {The Uses of Argument},
  publisher = {Cambridge University Press},
  address   = {Cambridge},
  year      = {1958},
  abstract  = {Klassiker der Argumentationstheorie. Toulmin ersetzt das
               formallogische Syllogismus-Schema durch ein Modell
               praktischen Argumentierens mit sechs Elementen: Behauptung
               (claim), Daten (data), Schlussregel (warrant), St{\"u}tzung
               (backing), Modaloperator (qualifier) und Ausnahmebedingung
               (rebuttal). Das Modell zeigt, dass gute Argumente ihre
               Reichweite einschr{\"a}nken und ihre Ausnahmen nennen. In LE~11
               Grundlage der Argumentationsstruktur These--Beleg--Schluss.}
}

@book{tufte2001visual,
  author    = {Tufte, Edward R.},
  title     = {The Visual Display of Quantitative Information},
  edition   = {2},
  publisher = {Graphics Press},
  address   = {Cheshire, CT},
  year      = {2001},
  abstract  = {Standardwerk zur Gestaltung statistischer Grafiken. Tufte
               fordert, den Anteil der Tinte, die Daten darstellt
               (data-ink ratio), zu maximieren und dekorative Elemente ohne
               Informationsgehalt (chartjunk) zu streichen; er zeigt an
               historischen Beispielen, wie Grafiken Daten verzerren oder
               klar machen k{\"o}nnen. F{\"u}r LE~12: Begriff des
               Signal-Rausch-Verh{\"a}ltnisses von Diagrammen und Folien.}
}

@book{tukey1977eda,
  author    = {Tukey, John W.},
  title     = {Exploratory Data Analysis},
  publisher = {Addison-Wesley},
  address   = {Reading, MA},
  year      = {1977},
  abstract  = {Gr{\"u}ndungswerk der explorativen Datenanalyse. Tukey setzt der
