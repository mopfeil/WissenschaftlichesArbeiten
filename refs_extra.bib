@article{button2013power,
  author  = {Button, Katherine S. and Ioannidis, John P. A. and Mokrysz, Claire
             and Nosek, Brian A. and Flint, Jonathan and Robinson, Emma S. J. and
             Munaf{\`o}, Marcus R.},
  title   = {Power Failure: Why Small Sample Size Undermines the Reliability of
             Neuroscience},
  journal = {Nature Reviews Neuroscience},
  volume  = {14},
  number  = {5},
  pages   = {365--376},
  year    = {2013},
  doi     = {10.1038/nrn3475},
  abstract = {Die Autorinnen und Autoren zeigen, dass viele Studien der
              Neurowissenschaften eine sehr geringe Testst{\"a}rke haben. Geringe
              Power bedeutet nicht nur, dass echte Effekte h{\"a}ufig {\"u}bersehen
              werden, sondern auch, dass ein \enquote{signifikanter} Befund mit
              geringerer Wahrscheinlichkeit einen echten Effekt widerspiegelt und
              dessen Gr{\"o}{\ss}e typischerweise {\"u}bersch{\"a}tzt
              (\enquote{winner's curse}). F{\"u}r das Skript: Warum kleine
              Stichproben in LE~8 und LE~10 zu sch{\"o}nen, aber unzuverl{\"a}ssigen
              Befunden f{\"u}hren.}
}

