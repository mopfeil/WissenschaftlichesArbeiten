  year     = {1974},
  abstract = {Grundlegender Aufsatz des Heuristics-and-Biases-Programms. Menschen
              urteilen unter Unsicherheit mit wenigen Faustregeln:
              Repr{\"a}sentativit{\"a}t, Verf{\"u}gbarkeit sowie Anpassung und Verankerung.
              Diese Heuristiken sind meist n{\"u}tzlich, f{\"u}hren aber zu
              systematischen, vorhersagbaren Fehlern, etwa zur Vernachl{\"a}ssigung
              von Basisraten, zur Fehleinsch{\"a}tzung von Stichprobengr{\"o}{\ss}en und
              zum Ankereffekt, bei dem ein willk{\"u}rlicher Ausgangswert
              nachfolgende Sch{\"a}tzungen pr{\"a}gt. Auch Fachleute sind davon nicht
              ausgenommen.}
