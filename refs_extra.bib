@article{wassersteinlazar2016asa,
  author  = {Wasserstein, Ronald L. and Lazar, Nicole A.},
  title   = {The {ASA} Statement on p-Values: Context, Process, and Purpose},
  journal = {The American Statistician},
  volume  = {70},
  number  = {2},
  pages   = {129--133},
  year    = {2016},
  doi     = {10.1080/00031305.2016.1154108},
  abstract = {Stellungnahme der American Statistical Association zum p-Wert mit
              sechs Grunds{\"a}tzen. Unter anderem: Ein p-Wert gibt an, wie
              unvertr{\"a}glich Daten mit einem bestimmten statistischen Modell
              sind; er misst weder die Wahrscheinlichkeit, dass die Hypothese wahr
              ist, noch die Wahrscheinlichkeit, dass die Daten nur durch Zufall
              entstanden sind. Wissenschaftliche Schl{\"u}sse sollen nicht allein
              davon abh{\"a}ngen, ob ein p-Wert eine Schwelle unterschreitet; ein
              p-Wert misst weder Gr{\"o}{\ss}e noch Bedeutung eines Effekts; korrekte
              Inferenz verlangt vollst{\"a}ndige Berichterstattung und Transparenz.
              F{\"u}r das Skript: Grundlage der Folie \enquote{Was der p-Wert nicht
              sagt} in LE~8.}
}

