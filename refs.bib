}

@book{hulley2013designing,
  author    = {Hulley, Stephen B. and Cummings, Steven R. and Browner, Warren S. and Grady, Deborah G. and Newman, Thomas B.},
  title     = {Designing Clinical Research},
  edition   = {4},
  publisher = {Lippincott Williams \& Wilkins},
  address   = {Philadelphia},
  year      = {2013},
  abstract  = {Lehrbuch zur Planung klinischer und epidemiologischer Studien. Bekannt ist es unter anderem f{\"u}r die FINER-Kriterien einer guten Forschungsfrage: durchf{\"u}hrbar (feasible), interessant, neu (novel), ethisch vertretbar und relevant. Weitere Kapitel behandeln Stichprobe, Messung, Designs und Studienprotokoll.}
}

@article{kerr1998harking,
  author  = {Kerr, Norbert L.},
  title   = {{HARKing}: Hypothesizing After the Results are Known},
  journal = {Personality and Social Psychology Review},
  volume  = {2},
  number  = {3},
  pages   = {196--217},
  year    = {1998},
  doi     = {10.1207/s15327957pspr0203_4},
  abstract = {Kerr pr{\"a}gt den Begriff HARKing: Eine Hypothese, die erst nach
              Sichtung der Ergebnisse gebildet wurde, wird im Bericht so
              dargestellt, als sei sie vorab aufgestellt worden. Er beschreibt
              Spielarten der Praxis, ihre Verbreitung und ihre Kosten: Zufallsbefunde
              werden als best{\"a}tigte Theorie ausgegeben, widerlegte Hypothesen
              verschwinden aus der Literatur, und Leserinnen und Leser k{\"o}nnen den
              Beweiswert eines Befundes nicht mehr einsch{\"a}tzen. F{\"u}r das Skript:
              HARKing als Fehlerquelle der Interpretation in LE~10.}
}

@incollection{lagarias2009kruskal,
  author    = {Lagarias, Jeffrey C. and Rains, Eric and Vanderbei, Robert J.},
  title     = {The {Kruskal} Count},
  booktitle = {The Mathematics of Preference, Choice and Order: Essays in Honor of Peter C. Fishburn},
  editor    = {Brams, Steven J. and Gehrlein, William V. and Roberts, Fred S.},
  publisher = {Springer},
  address   = {Berlin, Heidelberg},
  pages     = {371--391},
  year      = {2009},
  abstract  = {Mathematische Analyse des Kartentricks, den Martin Kruskal in den 1970er-Jahren beschrieb: Zwei Personen folgen unabh{\"a}ngig von verschiedenen Startpunkten einer Z{\"a}hlregel durch ein Kartenspiel und landen mit hoher Wahrscheinlichkeit auf derselben Schlusskarte. Die Autoren modellieren das Verfahren als Kopplung von Markov-Ketten, sch{\"a}tzen die Erfolgswahrscheinlichkeit ab und zeichnen die Geschichte des Effekts nach, der durch Martin Gardner bekannt wurde.}
}

@book{lincolnguba1985naturalistic,
  author    = {Lincoln, Yvonna S. and Guba, Egon G.},
  title     = {Naturalistic Inquiry},
  publisher = {Sage},
  address   = {Beverly Hills, CA},
  year      = {1985},
  abstract  = {Grundlegende Methodologie qualitativ-naturalistischer Forschung.
               Lincoln und Guba setzen den Kriterien quantitativer Forschung
               (interne und externe Validit{\"a}t, Reliabilit{\"a}t, Objektivit{\"a}t)
               vier Entsprechungen f{\"u}r interpretative Studien entgegen:
               Credibility (Glaubw{\"u}rdigkeit, etwa durch l{\"a}ngeres Feldengagement,
               Triangulation und member checking), Transferability ({\"U}bertragbarkeit
               durch dichte Beschreibung), Dependability (Zuverl{\"a}ssigkeit durch
               nachvollziehbare Dokumentation) und Confirmability (Best{\"a}tigbarkeit
               durch einen Audit Trail). F{\"u}r das Skript: Quelle der G{\"u}tekriterien
               in LE~9.}
}

@article{loftus1974reconstruction,
  author   = {Loftus, Elizabeth F. and Palmer, John C.},
  title    = {Reconstruction of Automobile Destruction: An Example of the Interaction Between Language and Memory},
  journal  = {Journal of Verbal Learning and Verbal Behavior},
  volume   = {13},
  number   = {5},
  pages    = {585--589},
  year     = {1974},
  abstract = {Versuchspersonen sahen Filme von Autounf{\"a}llen und sch{\"a}tzten danach die Geschwindigkeit. Wurde in der Frage ein st{\"a}rkeres Verb verwendet (smashed statt hit), fielen die Sch{\"a}tzungen h{\"o}her aus, und eine Woche sp{\"a}ter berichteten mehr Personen von zerbrochenem Glas, das im Film nicht zu sehen war. Die Studie zeigt, dass die Formulierung einer Frage Antworten und Erinnerung ver{\"a}ndert.}
}

@article{loftuspalmer1974,
  author  = {Loftus, Elizabeth F. and Palmer, John C.},
  title   = {Reconstruction of Automobile Destruction: An Example of the
             Interaction Between Language and Memory},
  journal = {Journal of Verbal Learning and Verbal Behavior},
  volume  = {13},
  number  = {5},
  pages   = {585--589},
  year    = {1974},
  doi     = {10.1016/S0022-5371(74)80011-3},
  abstract = {Klassisches Experiment zur Wirkung der Frageformulierung.
              Versuchspersonen sahen Filme von Autounf{\"a}llen und sch{\"a}tzten
              anschlie{\ss}end die Geschwindigkeit. Wurde im Fragetext das Verb
              \enquote{smashed} statt \enquote{hit} verwendet, fielen die
              Sch{\"a}tzungen h{\"o}her aus, und eine Woche sp{\"a}ter berichteten
              mehr Personen von zerbrochenem Glas, das im Film nicht vorkam. Die
              Formulierung einer Frage ver{\"a}ndert also nicht nur die Antwort,
              sondern auch die Erinnerung. F{\"u}r das Skript: Beleg in LE~9, dass
              Interviewsprache die erhobene Wirklichkeit mitformt.}
}

@book{mayer2009multimedia,
  author    = {Mayer, Richard E.},
  title     = {Multimedia Learning},
  edition   = {2},
  publisher = {Cambridge University Press},
  address   = {New York},
  year      = {2009},
  abstract  = {Zusammenfassung des Forschungsprogramms zum Lernen mit Wort und
               Bild. Mayer leitet aus Experimenten Gestaltungsprinzipien ab,
               u.\,a.\ Koh{\"a}renz (Unwesentliches weglassen), Signalisierung
               (Wesentliches hervorheben), Redundanz (gesprochenen Text nicht
               zus{\"a}tzlich vollst{\"a}ndig einblenden), r{\"a}umliche und zeitliche
               N{\"a}he von Wort und Bild sowie Segmentierung. F{\"u}r LE~12:
               Kriterien der Folienkritik.}
}

@book{mayring2015inhaltsanalyse,
  author    = {Mayring, Philipp},
  title     = {Qualitative Inhaltsanalyse. Grundlagen und Techniken},
  edition   = {12},
  publisher = {Beltz},
  address   = {Weinheim und Basel},
  year      = {2015},
  abstract  = {Standardwerk zur qualitativen Inhaltsanalyse im deutschsprachigen
               Raum. Mayring beschreibt ein regelgeleitetes Verfahren, sprachliches
               Material (Interviews, Dokumente) schrittweise in ein Kategoriensystem
               zu {\"u}berf{\"u}hren. Die drei Grundformen sind Zusammenfassung
               (induktive Kategorienbildung am Material), Explikation (Kontextanalyse
               unklarer Stellen) und Strukturierung (deduktive Anwendung vorab
               definierter Kategorien mit Definition, Ankerbeispiel und
               Kodierregel). G{\"u}te wird {\"u}ber Regelgeleitetheit,
               Nachvollziehbarkeit und Intercoder-{\"U}bereinstimmung gesichert.
               F{\"u}r das Skript: Grundlage des Codier-Vergleichs in LE~9.}
}

@article{merton1968matthew,
  author   = {Merton, Robert K.},
  title    = {The {Matthew} Effect in Science},
  journal  = {Science},
  volume   = {159},
  number   = {3810},
  pages    = {56--63},
  year     = {1968},
  doi      = {10.1126/science.159.3810.56},
  abstract = {Merton beschreibt, dass bereits bekannte Forschende f{\"u}r
              vergleichbare Beitr{\"a}ge mehr Anerkennung erhalten als
              unbekannte (\enquote{Wer hat, dem wird gegeben}). Der Effekt
              verst{\"a}rkt sich selbst und pr{\"a}gt, wessen Arbeiten gelesen
              und zitiert werden. F{\"u}r die Quellenkritik folgt daraus, dass
              Zitationszahlen auch Sichtbarkeit und Reputation abbilden, nicht
              nur Qualit{\"a}t.}
}

@article{nosek2018preregistration,
  author  = {Nosek, Brian A. and Ebersole, Charles R. and DeHaven, Alexander C.
             and Mellor, David T.},
  title   = {The Preregistration Revolution},
  journal = {Proceedings of the National Academy of Sciences},
  volume  = {115},
  number  = {11},
  pages   = {2600--2606},
  year    = {2018},
  doi     = {10.1073/pnas.1708274114},
  abstract = {Die Autoren unterscheiden zwei Modi der Forschung: Vorhersage
              (Hypothesen pr{\"u}fen) und Nachhersage (Hypothesen aus den Daten
              gewinnen). Beide sind legitim, werden aber h{\"a}ufig verwechselt, was
              die Aussagekraft statistischer Tests untergr{\"a}bt. Pr{\"a}registrierung,
              also das Festlegen von Hypothesen und Auswertungsplan vor der
              Datensichtung, macht sichtbar, welcher Modus vorliegt. Der Beitrag
              diskutiert Einw{\"a}nde und praktische Umsetzung. F{\"u}r das Skript:
              Pr{\"a}registrierung als Gegenmittel in LE~10.}
}

@article{oppenheimer2006erudite,
  author  = {Oppenheimer, Daniel M.},
  title   = {Consequences of Erudite Vernacular Utilized Irrespective of
             Necessity: Problems with Using Long Words Needlessly},
  journal = {Applied Cognitive Psychology},
  volume  = {20},
  number  = {2},
  pages   = {139--156},
  year    = {2006},
  doi     = {10.1002/acp.1178},
  abstract = {F{\"u}nf Experimente zur Wirkung komplizierter Sprache. Texte, in
              denen W{\"o}rter durch l{\"a}ngere Synonyme ersetzt wurden, f{\"u}hrten
              dazu, dass Leserinnen und Leser die Verfasser als weniger
              intelligent einsch{\"a}tzten; erkl{\"a}rt wird der Befund mit der
              geringeren Verarbeitungsfl{\"u}ssigkeit. Der Effekt verschwand,
              wenn die Schwierigkeit einer anderen Ursache zugeschrieben werden
