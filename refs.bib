}

@book{helfferich2011qualitaet,
  author    = {Helfferich, Cornelia},
  title     = {Die Qualit{\"a}t qualitativer Daten. Manual f{\"u}r die
               Durchf{\"u}hrung qualitativer Interviews},
  edition   = {4},
  publisher = {VS Verlag f{\"u}r Sozialwissenschaften},
  address   = {Wiesbaden},
  year      = {2011},
  abstract  = {Praxisnahes Handbuch zur Planung und F{\"u}hrung qualitativer
               Interviews. Helfferich versteht das Interview als
               Kommunikationssituation, in der die Daten gemeinsam hervorgebracht
               werden, und fordert deshalb Reflexion statt vermeintlicher
               Neutralit{\"a}t. Bekannt ist ihr SPSS-Prinzip zur Leitfadenerstellung:
