@article{klaymanha1987,
  author    = {Klayman, Joshua and Ha, Young-Won},
  title     = {Confirmation, Disconfirmation, and Information in Hypothesis Testing},
  journal   = {Psychological Review},
  year      = {1987},
  volume    = {94},
  number    = {2},
  pages     = {211--228},
  doi       = {10.1037/0033-295X.94.2.211},
  abstract  = {Einflussreiche Neudeutung der \enquote{Confirmation-Bias}-Befunde. Klayman und Ha zeigen, dass viele als Best\"atigungsfehler etikettierte Ph\"anomene -- darunter Wasons 2--4--6-Aufgabe -- besser durch eine allgemeine \emph{positive Teststrategie} erkl\"art werden: die Neigung, bevorzugt jene F\"alle zu pr\"ufen, von denen man das interessierende Merkmal erwartet. Entscheidend ist ihre Differenzierung: Diese Strategie ist in vielen realen Umgebungen ein \emph{gutes} Heuristikum und f\"uhrt nur dann systematisch in die Irre, wenn die wahre Regel \emph{weiter} gefasst ist als die gepr\"ufte Hypothese (wie in Wasons Aufgabe konstruiert). Die Arbeit verhindert eine vorschnelle Pathologisierung des Hypothesenpr\"ufens und liefert die evenhanded Einordnung, die das Buch \"ubernimmt.}
}

@article{kuhn2016,
