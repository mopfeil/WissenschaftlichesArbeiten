  howpublished = {\url{https://sfdora.org/read/}},
  abstract     = {Die 2012 auf der Jahrestagung der American Society for Cell
                  Biology formulierte Erkl{\"a}rung fordert, zeitschriftenbasierte
                  Metriken wie den Impact Factor nicht als Ersatzma{\ss} f{\"u}r
                  die Qualit{\"a}t einzelner Artikel oder f{\"u}r Einstellungs-,
                  Berufungs- und F{\"o}rderentscheidungen zu verwenden.
                  Forschung soll nach ihrem Inhalt bewertet werden. Die
                  Erkl{\"a}rung wurde seither von zahlreichen Organisationen und
                  Einzelpersonen unterzeichnet.}
}

@article{doran1981smart,
  author   = {Doran, George T.},
  title    = {There's a {S.M.A.R.T.} Way to Write Management's Goals and Objectives},
  journal  = {Management Review},
  volume   = {70},
  number   = {11},
  pages    = {35--36},
  year     = {1981},
  abstract = {Kurzer Praxisbeitrag aus dem Management, der die Abk{\"u}rzung SMART f{\"u}r gut formulierte Ziele einf{\"u}hrt: spezifisch, messbar, zuordenbar (assignable), realistisch und zeitgebunden. Doran betont, dass nicht jedes Ziel alle f{\"u}nf Kriterien erf{\"u}llen muss, die Liste aber hilft, vage Absichten in pr{\"u}fbare Vorhaben zu {\"u}bersetzen. In der Methodenlehre wird das Schema heute h{\"a}ufig auf Forschungsfragen {\"u}bertragen.}
}

@misc{dsgvo2016,
  author       = {{Europ{\"a}isches Parlament und Rat der Europ{\"a}ischen Union}},
  title        = {Verordnung (EU) 2016/679 zum Schutz nat{\"u}rlicher Personen bei
                  der Verarbeitung personenbezogener Daten, zum freien
                  Datenverkehr und zur Aufhebung der Richtlinie 95/46/EG
                  (Datenschutz-Grundverordnung)},
  howpublished = {Amtsblatt der Europ{\"a}ischen Union, L~119, 4.~Mai 2016, S.~1--88},
