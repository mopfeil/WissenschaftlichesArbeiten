  volume   = {16},
  number   = {1},
  pages    = {107--112},
  year     = {1977},
  doi      = {10.1016/S0022-5371(77)80012-1},
  abstract = {Erstbeschreibung des sp{\"a}ter so genannten
              \emph{Illusory-Truth}-Effekts: Plausible Aussagen, deren Wahrheit
              die Versuchspersonen nicht kannten, wurden bei wiederholter
              Darbietung im Lauf mehrerer Sitzungen als zunehmend wahr
