               Luckmann beschreiben, wie Menschen in Interaktion und Sprache eine
               gemeinsame Alltagswirklichkeit hervorbringen, die ihnen anschlie{\ss}end
               als objektiv gegeben erscheint (Externalisierung, Objektivierung,
               Internalisierung). Das Werk ist eine Grundlage des
               sozialkonstruktivistischen Verst{\"a}ndnisses, auf das sich viele
               qualitative Ans{\"a}tze berufen. F{\"u}r das Skript: Hintergrund zu
               Konstruktivismus und Intersubjektivit{\"a}t in LE~9.}
}

@book{booth2016craft,
  author    = {Booth, Wayne C. and Colomb, Gregory G. and Williams, Joseph M. and Bizup, Joseph and FitzGerald, William T.},
  title     = {The Craft of Research},
  edition   = {4},
  publisher = {University of Chicago Press},
  address   = {Chicago},
  year      = {2016},
  abstract  = {Klassische Anleitung zum Forschen und Schreiben. Die Autoren beschreiben den Weg vom Interesse {\"u}ber das Thema zur Frage und zum Problem und schlagen dazu eine dreiteilige Formel vor: Ich untersuche X, weil ich herausfinden will Y, damit meine Leserinnen und Leser Z verstehen. Weitere Teile behandeln Quellensuche, Argumentation und Darstellung.}
}

@book{bridgman1927logic,
  author    = {Bridgman, Percy W.},
  title     = {The Logic of Modern Physics},
  publisher = {Macmillan},
  address   = {New York},
  year      = {1927},
  abstract  = {Der Physiker Bridgman entwickelt unter dem Eindruck der Relativit{\"a}tstheorie den Operationalismus: Die Bedeutung eines physikalischen Begriffs ist durch die Operationen bestimmt, mit denen man ihn misst. Die These wurde in ihrer strengen Form vielfach kritisiert, pr{\"a}gte aber den Begriff der Operationalisierung in Psychologie und Sozialwissenschaften.}
}

@article{buckingham2014,
  author   = {Buckingham, Gavin},
  title    = {Getting a Grip on Heaviness Perception: A Review of Weight Illusions and Their Probable Causes},
  journal  = {Experimental Brain Research},
  volume   = {232},
  number   = {6},
  pages    = {1623--1629},
  year     = {2014},
  abstract = {{\"U}bersichtsarbeit zu Gewichtst{\"a}uschungen, insbesondere zur
              Gr{\"o}{\ss}e-Gewicht-Illusion und zur Material-Gewicht-Illusion. Der
              Autor diskutiert sensomotorische, kognitive und bayesianische
              Erkl{\"a}rungsans{\"a}tze und zeigt, dass keiner allein die Befundlage
              erkl{\"a}rt. Gemeinsam ist den meisten Ans{\"a}tzen, dass Erwartungen
              {\"u}ber das Gewicht die Wahrnehmung formen, wobei das Ergebnis der
              Erwartung entgegengesetzt ist: Was leichter erwartet wird,
              f{\"u}hlt sich schwerer an.}
}

@article{button2013power,
  author  = {Button, Katherine S. and Ioannidis, John P. A. and Mokrysz, Claire
             and Nosek, Brian A. and Flint, Jonathan and Robinson, Emma S. J. and
             Munaf{\`o}, Marcus R.},
  title   = {Power Failure: Why Small Sample Size Undermines the Reliability of
             Neuroscience},
  journal = {Nature Reviews Neuroscience},
  volume  = {14},
  number  = {5},
  pages   = {365--376},
  year    = {2013},
  doi     = {10.1038/nrn3475},
  abstract = {Die Autorinnen und Autoren zeigen, dass viele Studien der
              Neurowissenschaften eine sehr geringe Testst{\"a}rke haben. Geringe
              Power bedeutet nicht nur, dass echte Effekte h{\"a}ufig {\"u}bersehen
              werden, sondern auch, dass ein \enquote{signifikanter} Befund mit
              geringerer Wahrscheinlichkeit einen echten Effekt widerspiegelt und
              dessen Gr{\"o}{\ss}e typischerweise {\"u}bersch{\"a}tzt
              (\enquote{winner's curse}). F{\"u}r das Skript: Warum kleine
              Stichproben in LE~8 und LE~10 zu sch{\"o}nen, aber unzuverl{\"a}ssigen
              Befunden f{\"u}hren.}
}

@book{caulfield2023verified,
  author    = {Caulfield, Mike and Wineburg, Sam},
  title     = {Verified: How to Think Straight, Get Duped Less, and Make Better Decisions about What to Believe Online},
  publisher = {University of Chicago Press},
  address   = {Chicago},
  year      = {2023},
  abstract  = {Die Autoren fassen ihre Arbeiten zur digitalen Quellenpr{\"u}fung
               zusammen. Im Mittelpunkt steht die SIFT-Methode (Stop,
               Investigate the source, Find better coverage, Trace claims to
               the original context), die auf dem lateralen Lesen
               professioneller Faktenpr{\"u}fer beruht: die Quelle verlassen,
               {\"u}ber sie nachlesen, statt in ihr weiterzulesen. Das Buch
               behandelt au{\ss}erdem den Umgang mit Suchmaschinen, Bildern,
               Expertenstatus und dem eigenen emotionalen Erstreflex.}
}

@article{charpentier1891,
  author   = {Charpentier, Augustin},
  title    = {Analyse exp{\'e}rimentale de quelques {\'e}l{\'e}ments de la sensation de poids},
  journal  = {Archives de physiologie normale et pathologique},
  volume   = {3},
  pages    = {122--135},
  year     = {1891},
  abstract = {Erstbeschreibung der Gr{\"o}{\ss}e-Gewicht-Illusion: Von zwei gleich
              schweren Objekten unterschiedlicher Gr{\"o}{\ss}e wird das kleinere
              beim Anheben als deutlich schwerer empfunden. Charpentier
              untersuchte die Gewichtsempfindung experimentell; die Illusion
              tr{\"a}gt seither seinen Namen und z{\"a}hlt zu den
              stabilsten Wahrnehmungst{\"a}uschungen der Psychophysik.}
}

@book{cohen1988power,
  author    = {Cohen, Jacob},
  title     = {Statistical Power Analysis for the Behavioral Sciences},
  edition   = {2},
  publisher = {Lawrence Erlbaum},
  address   = {Hillsdale, NJ},
  year      = {1988},
  abstract  = {Standardwerk zur Testst{\"a}rke- und Fallzahlplanung. Cohen f{\"u}hrt
              standardisierte Effektgr{\"o}{\ss}en (u.\,a. $d$ f{\"u}r
              Mittelwertunterschiede) ein und schl{\"a}gt als grobe Orientierung
              die Konventionen klein ($d=0{,}2$), mittel ($d=0{,}5$) und gro{\ss}
              ($d=0{,}8$) vor. Das Buch enth{\"a}lt Tafeln, aus denen sich f{\"u}r
              gegebenes Signifikanzniveau, erwartete Effektgr{\"o}{\ss}e und
              gew{\"u}nschte Testst{\"a}rke (meist 0,80) die n{\"o}tige Stichprobengr{\"o}{\ss}e
              ablesen l{\"a}sst. F{\"u}r das Skript: Effektgr{\"o}{\ss}e und Power in LE~8.}
}

@book{conrad1958schizophrenie,
  author    = {Conrad, Klaus},
  title     = {Die beginnende Schizophrenie. Versuch einer Gestaltanalyse des Wahns},
  publisher = {Thieme},
  address   = {Stuttgart},
  year      = {1958},
  abstract  = {Psychiatrische Monographie, in der Conrad den Begriff der
               \emph{Apoph{\"a}nie} pr{\"a}gt: das grundlose Erleben von
               Bedeutung und Zusammenhang in zuf{\"a}lligen Wahrnehmungen, wie
               es in fr{\"u}hen Phasen wahnhaften Erlebens auftritt. Der Begriff
               wurde sp{\"a}ter auf die allgemeine menschliche Neigung
               {\"u}bertragen, in Rauschen Muster zu sehen.}
}

@article{cowan2001magical,
  author  = {Cowan, Nelson},
  title   = {The Magical Number 4 in Short-Term Memory: A Reconsideration of
             Mental Storage Capacity},
  journal = {Behavioral and Brain Sciences},
  volume  = {24},
  number  = {1},
  pages   = {87--114},
  year    = {2001},
  doi     = {10.1017/S0140525X01003922},
  abstract = {{\"U}bersichtsarbeit zur Kapazit{\"a}t des Kurzzeitged{\"a}chtnisses.
              Cowan zeigt, dass Millers \enquote{magische Zahl sieben} die
              Kapazit{\"a}t {\"u}bersch{\"a}tzt, wenn Gruppierung und Wiederholung
              ausgeschlossen werden; die Grenze liegt dann bei etwa drei bis
              f{\"u}nf Einheiten (Chunks). F{\"u}r LE~12: Begr{\"u}ndung, warum eine
              Folie nur wenige gleichzeitig zu haltende Elemente enthalten sollte.}
}

@book{denzin1970research,
  author    = {Denzin, Norman K.},
  title     = {The Research Act. A Theoretical Introduction to Sociological Methods},
  publisher = {Aldine},
  address   = {Chicago},
  year      = {1970},
  abstract  = {Methodologisches Lehrbuch, das den Begriff der Triangulation in
               der Sozialforschung etabliert. Denzin unterscheidet Daten-,
               Forscher-, Theorien- und Methodentriangulation: Ein Gegenstand wird
               aus mehreren Blickwinkeln, mit mehreren Datenquellen, durch mehrere
               Personen oder mit mehreren Methoden untersucht, damit die
               Schw{\"a}chen eines einzelnen Zugangs nicht unbemerkt bleiben.
               F{\"u}r das Skript: Triangulation in LE~9 und LE~10.}
}

@techreport{dfg2019kodex,
  author      = {{Deutsche Forschungsgemeinschaft}},
  title       = {Leitlinien zur Sicherung guter wissenschaftlicher Praxis.
                 Kodex},
  institution = {Deutsche Forschungsgemeinschaft},
  address     = {Bonn},
  year        = {2019},
  abstract    = {Der Kodex der DFG l{\"o}ste 2019 die Denkschrift
                 \enquote{Sicherung guter wissenschaftlicher Praxis} ab. In 19
                 Leitlinien beschreibt er die Grundprinzipien redlichen
                 Forschens, darunter lege artis arbeiten, Ehrlichkeit gegen{\"u}ber
                 eigenen und fremden Beitr{\"a}gen, Dokumentation, Archivierung von
                 Forschungsdaten, {\"o}ffentlicher Zugang zu Ergebnissen, Kriterien
                 der Autorschaft, Vertraulichkeit bei Begutachtungen sowie
                 Ombudspersonen und Verfahren bei Verdacht auf Fehlverhalten.
                 Hochschulen m{\"u}ssen die Leitlinien rechtsverbindlich umsetzen,
                 um DFG-Mittel zu erhalten. Grundlage der Ethik-Werkstatt in
                 LE~13.}
}

@book{doering2016forschungsmethoden,
  author    = {D{\"o}ring, Nicola and Bortz, J{\"u}rgen},
  title     = {Forschungsmethoden und Evaluation in den Sozial- und Humanwissenschaften},
  edition   = {5},
  publisher = {Springer},
  address   = {Berlin, Heidelberg},
  year      = {2016},
  abstract  = {Deutschsprachiges Standardlehrbuch der empirischen Forschungsmethoden. Es f{\"u}hrt vom wissenschaftstheoretischen Fundament {\"u}ber die Formulierung von Forschungsproblemen, Forschungsfragen und Hypothesen, Operationalisierung und Untersuchungsdesign bis zu Datenerhebung, Auswertung und Evaluation. Ein eigenes Kapitel behandelt die Literaturrecherche und den Forschungsstand.}
}

@book{doeringbortz2016,
  author    = {D{\"o}ring, Nicola and Bortz, J{\"u}rgen},
  title     = {Forschungsmethoden und Evaluation in den Sozial- und
               Humanwissenschaften},
  edition   = {5},
  publisher = {Springer},
  address   = {Berlin und Heidelberg},
  year      = {2016},
  abstract  = {Deutschsprachiges Standardlehrbuch der empirischen
               Sozialforschung. Es behandelt Wissenschaftstheorie,
               Forschungsdesigns, Stichprobenziehung, Datenerhebung
               (Beobachtung, Interview, Fragebogen, Dokumentenanalyse),
