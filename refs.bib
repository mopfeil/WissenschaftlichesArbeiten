  title     = {On the Failure to Eliminate Hypotheses in a Conceptual Task},
  journal   = {Quarterly Journal of Experimental Psychology},
  year      = {1960},
  volume    = {12},
  number    = {3},
  pages     = {129--140},
  doi       = {10.1080/17470216008416717},
  abstract  = {Wasons klassische Studie zum induktiven Schlie{\ss}en: 29 Studierende sollten anhand des Tripels \enquote{2--4--6} die dahinterliegende Regel erraten, indem sie eigene Zahlentripel vorschlugen und jeweils nur die R\"uckmeldung \enquote{passt} oder \enquote{passt nicht} erhielten. Die gesuchte Regel war bewusst sehr weit gefasst (\enquote{drei aufsteigende Zahlen}), doch die meisten Versuchspersonen bildeten sofort eine engere Hypothese (etwa \enquote{plus zwei}) und pr\"uften nur noch Tripel, die diese Hypothese best\"atigten -- ein \enquote{positiver} Test, der bei einer zu engen Hypothese stets ein \enquote{Ja} liefert und den Irrtum dadurch verschleiert. Nur sechs Personen fanden die Regel ohne falschen Zwischenschluss. Wason deutete dies als Versagen, Hypothesen aktiv zu \emph{eliminieren} (zu falsifizieren), und pr\"agte in diesem Umfeld den Begriff des \emph{confirmation bias}. Eine der meistzitierten Arbeiten der kognitiven Psychologie und empirische Grundlage des im Buch verwendeten Zahlenreihen-Experiments.}
}

