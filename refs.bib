}

@article{hirsch2005index,
  author   = {Hirsch, Jorge E.},
  title    = {An Index to Quantify an Individual's Scientific Research Output},
  journal  = {Proceedings of the National Academy of Sciences},
  volume   = {102},
  number   = {46},
  pages    = {16569--16572},
  year     = {2005},
  doi      = {10.1073/pnas.0507655102},
  abstract = {Hirsch schl{\"a}gt den sp{\"a}ter nach ihm benannten h-Index vor:
              Eine Person hat den Index $h$, wenn $h$ ihrer Arbeiten jeweils
              mindestens $h$-mal zitiert wurden. Die Kennzahl soll Umfang und
