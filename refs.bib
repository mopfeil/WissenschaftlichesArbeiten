                  Anonyme Daten fallen nicht unter die Verordnung
                  (Erw{\"a}gungsgrund~26). Grundlage des Datenschutzteils in LE~13.}
}

@article{fischhoff1975hindsight,
  author   = {Fischhoff, Baruch},
  title    = {Hindsight $\neq$ Foresight: The Effect of Outcome Knowledge on Judgment under Uncertainty},
  journal  = {Journal of Experimental Psychology: Human Perception and Performance},
  volume   = {1},
  number   = {3},
  pages    = {288--299},
  year     = {1975},
  abstract = {Versuchspersonen lasen Beschreibungen historischer und klinischer
              Ereignisse, teils mit, teils ohne Angabe des tats{\"a}chlichen
              Ausgangs. Wer den Ausgang kannte, hielt ihn f{\"u}r deutlich
              wahrscheinlicher und glaubte zugleich, ihn auch ohne dieses
              Wissen so eingesch{\"a}tzt zu haben. Fischhoff beschreibt damit den
              R{\"u}ckschaufehler (hindsight bias, \enquote{creeping determinism}):
              Wissen um das Ergebnis ver{\"a}ndert unbemerkt die Erinnerung an die
              eigene fr{\"u}here Einsch{\"a}tzung.}
}

@article{flanagan2000independence,
  author   = {Flanagan, J. Randall and Beltzner, Michael A.},
  title    = {Independence of Perceptual and Sensorimotor Predictions in the Size--Weight Illusion},
  journal  = {Nature Neuroscience},
  volume   = {3},
  number   = {7},
  pages    = {737--741},
  year     = {2000},
  abstract = {Versuchspersonen hoben wiederholt gleich schwere W{\"u}rfel
              unterschiedlicher Gr{\"o}{\ss}e. Die Griff- und Hebekr{\"a}fte passten
              sich nach wenigen Versuchen dem tats{\"a}chlichen Gewicht an, die
              Gr{\"o}{\ss}e-Gewicht-Illusion blieb dagegen in voller St{\"a}rke
              bestehen. Die Autoren schlie{\ss}en, dass motorische und
              wahrnehmungsbezogene Gewichtsvorhersagen voneinander unabh{\"a}ngig
              sind: Die Hand lernt, die Wahrnehmung nicht. Damit l{\"a}sst sich
              die Illusion nicht einfach als Folge falsch dosierter Kraft
              erkl{\"a}ren.}
}

@article{garfield1955citation,
  author   = {Garfield, Eugene},
  title    = {Citation Indexes for Science: A New Dimension in Documentation through Association of Ideas},
  journal  = {Science},
  volume   = {122},
  number   = {3159},
  pages    = {108--111},
  year     = {1955},
  abstract = {Garfield schl{\"a}gt einen Zitationsindex f{\"u}r die Naturwissenschaften vor: Statt Literatur nur {\"u}ber Schlagw{\"o}rter zu erschlie{\ss}en, soll man von einem Aufsatz aus alle sp{\"a}teren Arbeiten finden k{\"o}nnen, die ihn zitieren. Der Vorschlag wurde zur Grundlage des Science Citation Index und damit der heutigen Zitationsdatenbanken.}
}

@article{garfield2006history,
  author   = {Garfield, Eugene},
  title    = {The History and Meaning of the Journal Impact Factor},
  journal  = {JAMA},
  volume   = {295},
  number   = {1},
  pages    = {90--93},
  year     = {2006},
  doi      = {10.1001/jama.295.1.90},
  abstract = {Der Begr{\"u}nder des Science Citation Index erl{\"a}utert, wie der
              Impact Factor entstand: als Hilfsmittel, um Zeitschriften f{\"u}r
              den Citation Index auszuw{\"a}hlen. Garfield beschreibt die
              Berechnung (Zitate eines Jahres auf die Artikel der beiden
              Vorjahre, geteilt durch deren Zahl) und warnt selbst vor dem
              Gebrauch der Kennzahl zur Bewertung einzelner Forschender.}
}

@article{gieryn1983boundary,
  author  = {Gieryn, Thomas F.},
  title   = {Boundary-Work and the Demarcation of Science from Non-Science:
             Strains and Interests in Professional Ideologies of Scientists},
  journal = {American Sociological Review},
  volume  = {48},
  number  = {6},
  pages   = {781--795},
  year    = {1983},
  doi     = {10.2307/2095325},
  abstract = {Gieryn f{\"u}hrt den Begriff \emph{boundary-work} ein: Die Grenze
              zwischen Wissenschaft und Nicht-Wissenschaft ist keine
              feste Eigenschaft von Wissen, sondern wird von Wissenschaftlern
