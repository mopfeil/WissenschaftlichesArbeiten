@book{horwich1982probability,
  author    = {Horwich, Paul},
  title     = {Probability and Evidence},
  publisher = {Cambridge University Press},
  address   = {Cambridge},
  year      = {1982},
  note      = {Cambridge Philosophy Classics Edition 2016, mit einem Vorwort von Colin Howson},
  isbn      = {978-1-316-50701-8},
  abstract  = {Horwich entwickelt eine einheitliche bayesianische Theorie der wissenschaftlichen Evidenz auf der Grundlage subjektiver Wahrscheinlichkeit (Glaubensgrade). Kernergebnisse: \"Uberzeugung hat Grade, und rationale Glaubensgrade m\"ussen den Wahrscheinlichkeitsaxiomen gen\"ugen (Dutch-Book-Argument). Evidenz ist eine normative, dreistellige Relation: $E$ best\"atigt $H$ relativ zu Hintergrundannahmen $B$ genau dann, wenn Rationalit\"at $P(H \mid E) > P(H)$ verlangt. Der besondere Beweiswert \"uberraschender Vorhersagen und strenger Tests folgt aus $P(H \mid E)/P(H) = 1/P(E)$. \"Uberraschung selbst ist definiert als Entwertung der Hintergrundannahmen ($P(C \mid E) \ll P(C)$) durch eine zuvor unplausible Alternativerkl\"arung. Das Rabenparadoxon wird \"uber die Art der Stichprobenziehung aufgel\"ost: Nur Beobachtungen mit Falsifikationsrisiko haben vollen Beweiswert. Vielf\"altige Evidenz wirkt durch Elimination plausibler Konkurrenzhypothesen; Vorhersage hat gegen\"uber nachtr\"aglicher Datenanpassung keinen intrinsischen Mehrwert; die Erhebung weiterer Daten reduziert beweisbar den erwarteten Fehler von Wahrscheinlichkeitsurteilen. Abschlie{\ss}end vermittelt der ,,modulierte Realismus'' zwischen Realismus und Instrumentalismus durch abgestuftes Vertrauen in Theorien.}
}

@misc{hqr2017,
