}

@article{page2021prisma,
  author   = {Page, Matthew J. and McKenzie, Joanne E. and Bossuyt, Patrick M. and Boutron, Isabelle and Hoffmann, Tammy C. and Mulrow, Cynthia D. and others},
  title    = {The {PRISMA} 2020 Statement: An Updated Guideline for Reporting Systematic Reviews},
  journal  = {BMJ},
  volume   = {372},
  pages    = {n71},
  year     = {2021},
  doi      = {10.1136/bmj.n71},
  abstract = {Aktualisierte Berichtsleitlinie f{\"u}r systematische {\"U}bersichtsarbeiten. Sie enth{\"a}lt eine Checkliste und ein Flussdiagramm, das dokumentiert, wie viele Datens{\"a}tze in welchen Quellen gefunden, aussortiert und schlie{\ss}lich eingeschlossen wurden. Ziel ist, dass Leserinnen und Leser die Suche und Auswahl nachvollziehen und wiederholen k{\"o}nnen.}
}

@book{paivio1986mental,
  author    = {Paivio, Allan},
  title     = {Mental Representations: A Dual Coding Approach},
  publisher = {Oxford University Press},
  address   = {New York},
  year      = {1986},
  abstract  = {Ausf{\"u}hrliche Darstellung der Dual-Coding-Theorie: Das
               kognitive System verarbeitet sprachliche und bildhafte
               Information in zwei getrennten, aber verbundenen
               Repr{\"a}sentationssystemen. Information, die in beiden Systemen
               kodiert ist, wird besser behalten. F{\"u}r LE~12: Grundlage f{\"u}r die
               Kombination von gesprochenem Wort und Bild auf Folien.}
}

@book{pfungst1907,
  author    = {Pfungst, Oskar},
  title     = {Das Pferd des Herrn von Osten (Der Kluge Hans): Ein Beitrag zur experimentellen Tier- und Menschen-Psychologie},
  publisher = {Johann Ambrosius Barth},
  address   = {Leipzig},
  year      = {1907},
  abstract  = {Untersuchung des Pferdes \enquote{Kluger Hans}, das angeblich rechnen
               konnte und Antworten durch Hufschl{\"a}ge gab. Pfungst zeigte mit
               systematisch variierten Bedingungen, dass das Pferd nur dann
               richtig antwortete, wenn die fragende Person die Antwort kannte
               und f{\"u}r das Tier sichtbar war: Es reagierte auf unwillk{\"u}rliche,
               minimale Bewegungen der Fragenden. Die Arbeit ist ein fr{\"u}hes
               Lehrst{\"u}ck f{\"u}r Versuchsleitereffekte und f{\"u}r den Wert von
               Blindbedingungen.}
}

@article{quine1951dogmas,
  author   = {Quine, Willard Van Orman},
  title    = {Two Dogmas of Empiricism},
  journal  = {The Philosophical Review},
  volume   = {60},
  number   = {1},
  pages    = {20--43},
  year     = {1951},
  abstract = {Quine kritisiert zwei Grundannahmen des logischen Empirismus: die
              scharfe Trennung analytischer und synthetischer Aussagen und den
              Reduktionismus, nach dem jede sinnvolle Aussage einzeln auf
              Erfahrung zur{\"u}ckf{\"u}hrbar sei. Stattdessen stehe unser Wissen als
              Ganzes vor dem Tribunal der Erfahrung; ein widerspenstiger Befund
              erzwinge Anpassungen irgendwo im Netz der {\"U}berzeugungen, ohne
              festzulegen, wo. Zusammen mit Duhems These {\"u}ber die Pr{\"u}fung
              physikalischer Hypothesen als Duhem-Quine-These bekannt: Eine
              Hypothese wird nie isoliert, sondern nur zusammen mit
              Hilfsannahmen gepr{\"u}ft.}
}

@article{reber1999fluency,
  author  = {Reber, Rolf and Schwarz, Norbert},
  title   = {Effects of Perceptual Fluency on Judgments of Truth},
  journal = {Consciousness and Cognition},
  volume  = {8},
  number  = {3},
  pages   = {338--342},
  year    = {1999},
  doi     = {10.1006/ccog.1999.0386},
  abstract = {Aussagen der Form \enquote{Stadt X liegt in Land Y} wurden in
              unterschiedlich gut lesbaren Farbkontrasten dargeboten. Leicht
              lesbare Aussagen wurden h{\"a}ufiger als wahr beurteilt als schwer
              lesbare. Wahrnehmungsfl{\"u}ssigkeit wirkt also als Hinweisreiz f{\"u}r
              Wahrheit, unabh{\"a}ngig vom Inhalt. F{\"u}r LE~12: Gestaltung und
              Vortragsfluss k{\"o}nnen Glaubw{\"u}rdigkeit erzeugen, die nicht vom
              Inhalt gedeckt ist.}
}

@article{rosenthal1963experimenter,
  author   = {Rosenthal, Robert and Fode, Kermit L.},
  title    = {The Effect of Experimenter Bias on the Performance of the Albino Rat},
  journal  = {Behavioral Science},
  volume   = {8},
  number   = {3},
  pages    = {183--189},
  year     = {1963},
  abstract = {Studierende trainierten Ratten im Labyrinth. Einem Teil wurde gesagt,
              ihre Tiere seien auf Labyrinthklugheit gez{\"u}chtet, dem anderen
              Teil, sie seien labyrinthdumm; tats{\"a}chlich waren die Tiere
              zuf{\"a}llig zugeteilt. Die angeblich klugen Ratten zeigten bessere
              Leistungen. Die Studie gilt als klassischer Beleg f{\"u}r den
              Versuchsleitereffekt (experimenter expectancy effect): Erwartungen
              der Forschenden beeinflussen die Daten, auch ohne bewusste
              Manipulation. Sie begr{\"u}ndet die Forderung nach
              Blindbedingungen bei der Datenerhebung.}
}

@article{rosenthal1979filedrawer,
  author   = {Rosenthal, Robert},
  title    = {The {\enquote{File Drawer Problem}} and Tolerance for Null Results},
  journal  = {Psychological Bulletin},
  volume   = {86},
  number   = {3},
  pages    = {638--641},
  year     = {1979},
  abstract = {Rosenthal benennt das Schubladenproblem: Studien ohne signifikantes
              Ergebnis werden seltener eingereicht und ver{\"o}ffentlicht und
              verschwinden in der Schublade. Die publizierte Literatur
              {\"u}bersch{\"a}tzt dadurch systematisch Effekte. Er schl{\"a}gt ein Ma{\ss}
              daf{\"u}r vor, wie viele unver{\"o}ffentlichte Nullbefunde n{\"o}tig w{\"a}ren,
              um einen Gesamtbefund aufzuheben (fail-safe N), und begr{\"u}ndet
              damit die Diskussion um den Publikationsbias.}
}

@article{seglen1997impact,
  author   = {Seglen, Per O.},
  title    = {Why the Impact Factor of Journals Should Not Be Used for Evaluating Research},
  journal  = {BMJ},
  volume   = {314},
  number   = {7079},
  pages    = {497},
  year     = {1997},
  doi      = {10.1136/bmj.314.7079.497},
  abstract = {Seglen zeigt, dass der Impact Factor einer Zeitschrift wenig
              {\"u}ber den einzelnen darin erschienenen Artikel aussagt: Die
              Zitationen innerhalb einer Zeitschrift sind stark schief verteilt,
              eine kleine Zahl von Artikeln tr{\"a}gt den Gro{\ss}teil der
              Zitate. Hinzu kommen Unterschiede zwischen Fachgebieten,
              Verzerrungen durch Artikeltypen und Selbstzitate. Der Beitrag ist
              eine der meistzitierten Warnungen vor dem Gebrauch des Impact
              Factors zur Bewertung von Personen und Einzelarbeiten.}
}

@book{shadish2002experimental,
  author    = {Shadish, William R. and Cook, Thomas D. and Campbell, Donald T.},
  title     = {Experimental and Quasi-Experimental Designs for Generalized Causal Inference},
  publisher = {Houghton Mifflin},
  address   = {Boston},
  year      = {2002},
  abstract  = {Standardwerk zur Planung experimenteller und quasi-experimenteller
               Studien. Die Autoren systematisieren vier Validit{\"a}tsarten
               (statistische Schlussvalidit{\"a}t, interne, Konstrukt- und externe
               Validit{\"a}t) und die typischen Bedrohungen der internen
               Validit{\"a}t wie Geschichte, Reifung, Testeffekte, Instrumentierung,
               Regression zur Mitte, Selektion und Ausfall. Sie zeigen, wie
               Kontrollgruppen, Zufallszuteilung, Vortests und wiederholte
               Messungen diese Bedrohungen ausschlie{\ss}en oder absch{\"a}tzen
               lassen, und behandeln die Verallgemeinerung kausaler Befunde {\"u}ber
               Personen, Situationen und Zeitpunkte hinweg.}
}

@book{swales1990genre,
  author    = {Swales, John M.},
  title     = {Genre Analysis: English in Academic and Research Settings},
  publisher = {Cambridge University Press},
  address   = {Cambridge},
  year      = {1990},
  abstract  = {Grundlegende Studie zur Gattungsanalyse wissenschaftlicher
               Texte. Swales beschreibt Fachtextsorten als kommunikative
               Handlungen einer Diskursgemeinschaft und entwickelt f{\"u}r
               Einleitungen von Forschungsartikeln das CARS-Modell (Create a
               Research Space) mit drei Z{\"u}gen: ein Forschungsfeld abstecken,
               eine Nische (L{\"u}cke) aufzeigen, die Nische mit der eigenen
               Arbeit besetzen. Grundlage des Vierschritts Thema--L{\"u}cke--Frage--Aufbau
               in LE~11.}
}

@article{sweller1988cognitive,
  author  = {Sweller, John},
  title   = {Cognitive Load During Problem Solving: Effects on Learning},
  journal = {Cognitive Science},
  volume  = {12},
  number  = {2},
  pages   = {257--285},
  year    = {1988},
  doi     = {10.1207/s15516709cog1202_4},
  abstract = {Ausgangsarbeit der Cognitive-Load-Theorie. Sweller argumentiert,
              dass Probleml{\"o}sen mit Mittel-Ziel-Analyse das begrenzte
              Arbeitsged{\"a}chtnis so stark beansprucht, dass f{\"u}r den Aufbau von
              Schemata wenig Kapazit{\"a}t bleibt; Lernmaterial sollte daher
              unn{\"o}tige Belastung vermeiden. F{\"u}r LE~12: theoretische
              Grundlage daf{\"u}r, Folien von allem zu befreien, was das
              Arbeitsged{\"a}chtnis ohne Nutzen belastet.}
}

@book{toulmin1958uses,
  author    = {Toulmin, Stephen E.},
  title     = {The Uses of Argument},
  publisher = {Cambridge University Press},
  address   = {Cambridge},
  year      = {1958},
  abstract  = {Klassiker der Argumentationstheorie. Toulmin ersetzt das
               formallogische Syllogismus-Schema durch ein Modell
               praktischen Argumentierens mit sechs Elementen: Behauptung
               (claim), Daten (data), Schlussregel (warrant), St{\"u}tzung
               (backing), Modaloperator (qualifier) und Ausnahmebedingung
               (rebuttal). Das Modell zeigt, dass gute Argumente ihre
               Reichweite einschr{\"a}nken und ihre Ausnahmen nennen. In LE~11
               Grundlage der Argumentationsstruktur These--Beleg--Schluss.}
}

@book{tufte2001visual,
  author    = {Tufte, Edward R.},
  title     = {The Visual Display of Quantitative Information},
  edition   = {2},
  publisher = {Graphics Press},
  address   = {Cheshire, CT},
  year      = {2001},
  abstract  = {Standardwerk zur Gestaltung statistischer Grafiken. Tufte
               fordert, den Anteil der Tinte, die Daten darstellt
               (data-ink ratio), zu maximieren und dekorative Elemente ohne
               Informationsgehalt (chartjunk) zu streichen; er zeigt an
               historischen Beispielen, wie Grafiken Daten verzerren oder
               klar machen k{\"o}nnen. F{\"u}r LE~12: Begriff des
               Signal-Rausch-Verh{\"a}ltnisses von Diagrammen und Folien.}
}

@book{tukey1977eda,
  author    = {Tukey, John W.},
  title     = {Exploratory Data Analysis},
  publisher = {Addison-Wesley},
  address   = {Reading, MA},
  year      = {1977},
  abstract  = {Gr{\"u}ndungswerk der explorativen Datenanalyse. Tukey setzt der
               reinen Pr{\"u}fstatistik das genaue Hinsehen auf Daten entgegen und
               f{\"u}hrt einfache, von Hand zu erstellende Darstellungen ein, darunter
               das Stamm-Blatt-Diagramm und den Boxplot mit der Ausrei{\ss}erregel
               \enquote{mehr als 1,5 Quartilsabst{\"a}nde au{\ss}erhalb der Box}.
               F{\"u}r das Skript: Visualisierung und Ausrei{\ss}er in LE~8.}
}

@article{tversky1974judgment,
  author   = {Tversky, Amos and Kahneman, Daniel},
  title    = {Judgment under Uncertainty: Heuristics and Biases},
  journal  = {Science},
  volume   = {185},
  number   = {4157},
  pages    = {1124--1131},
  year     = {1974},
  abstract = {Grundlegender Aufsatz des Heuristics-and-Biases-Programms. Menschen
              urteilen unter Unsicherheit mit wenigen Faustregeln:
              Repr{\"a}sentativit{\"a}t, Verf{\"u}gbarkeit sowie Anpassung und Verankerung.
              Diese Heuristiken sind meist n{\"u}tzlich, f{\"u}hren aber zu
              systematischen, vorhersagbaren Fehlern, etwa zur Vernachl{\"a}ssigung
              von Basisraten, zur Fehleinsch{\"a}tzung von Stichprobengr{\"o}{\ss}en und
              zum Ankereffekt, bei dem ein willk{\"u}rlicher Ausgangswert
              nachfolgende Sch{\"a}tzungen pr{\"a}gt. Auch Fachleute sind davon nicht
              ausgenommen.}
}

@article{wassersteinlazar2016asa,
  author  = {Wasserstein, Ronald L. and Lazar, Nicole A.},
  title   = {The {ASA} Statement on p-Values: Context, Process, and Purpose},
  journal = {The American Statistician},
  volume  = {70},
  number  = {2},
  pages   = {129--133},
  year    = {2016},
  doi     = {10.1080/00031305.2016.1154108},
  abstract = {Stellungnahme der American Statistical Association zum p-Wert mit
              sechs Grunds{\"a}tzen. Unter anderem: Ein p-Wert gibt an, wie
              unvertr{\"a}glich Daten mit einem bestimmten statistischen Modell
              sind; er misst weder die Wahrscheinlichkeit, dass die Hypothese wahr
              ist, noch die Wahrscheinlichkeit, dass die Daten nur durch Zufall
              entstanden sind. Wissenschaftliche Schl{\"u}sse sollen nicht allein
              davon abh{\"a}ngen, ob ein p-Wert eine Schwelle unterschreitet; ein
              p-Wert misst weder Gr{\"o}{\ss}e noch Bedeutung eines Effekts; korrekte
              Inferenz verlangt vollst{\"a}ndige Berichterstattung und Transparenz.
              F{\"u}r das Skript: Grundlage der Folie \enquote{Was der p-Wert nicht
              sagt} in LE~8.}
}

@article{whitson2008lacking,
  author   = {Whitson, Jennifer A. and Galinsky, Adam D.},
  title    = {Lacking Control Increases Illusory Pattern Perception},
  journal  = {Science},
  volume   = {322},
  number   = {5898},
  pages    = {115--117},
  year     = {2008},
  doi      = {10.1126/science.1159845},
  abstract = {In mehreren Experimenten erlebten Versuchspersonen, deren
              Kontrollgef{\"u}hl zuvor geschw{\"a}cht worden war, h{\"a}ufiger
              Bilder in Rauschmustern, sahen h{\"a}ufiger Verschw{\"o}rungen
              und bildeten h{\"a}ufiger abergl{\"a}ubische Zusammenh{\"a}nge.
              Die Autoren deuten illusorische Mustererkennung als Versuch,
              Ordnung und Vorhersagbarkeit wiederherzustellen.}
}

@article{wilkinson2016fair,
  author  = {Wilkinson, Mark D. and others},
  title   = {The {FAIR} Guiding Principles for Scientific Data Management and
             Stewardship},
  journal = {Scientific Data},
  volume  = {3},
  pages   = {160018},
  year    = {2016},
  doi     = {10.1038/sdata.2016.18},
  abstract = {Formulierung der FAIR-Prinzipien f{\"u}r Forschungsdaten: Daten
              sollen auffindbar (Findable), zug{\"a}nglich (Accessible),
              interoperabel (Interoperable) und wiederverwendbar (Reusable)
              sein, und zwar f{\"u}r Menschen und Maschinen. FAIR verlangt nicht,
              dass alle Daten offen sind, sondern dass ihre Bedingungen klar
              beschrieben sind. F{\"u}r LE~13: Ma{\ss}stab f{\"u}r Open Data, der mit
              Datenschutz vereinbar ist.}
}

@inproceedings{wohlin2014snowballing,
  author    = {Wohlin, Claes},
  title     = {Guidelines for Snowballing in Systematic Literature Studies and a Replication in Software Engineering},
  booktitle = {Proceedings of the 18th International Conference on Evaluation and Assessment in Software Engineering (EASE '14)},
  publisher = {ACM},
  address   = {New York},
  year      = {2014},
  doi       = {10.1145/2601248.2601268},
  abstract  = {Wohlin beschreibt ein geregeltes Verfahren f{\"u}r die Schneeballsuche: Von einer Startmenge relevanter Arbeiten aus werden die Literaturlisten (r{\"u}ckw{\"a}rts) und die zitierenden Arbeiten (vorw{\"a}rts) in Runden durchgesehen, bis keine neuen relevanten Treffer mehr auftauchen. Eine Replikation einer datenbankbasierten Literaturstudie zeigt, dass das Verfahren eine ernsthafte Alternative zur Schlagwortsuche sein kann.}
}
