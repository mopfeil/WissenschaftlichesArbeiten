              Begriffs Grenzarbeit, den Rappert und Kuhn auf die Enth{\"u}llung
              von Zaubertricks {\"u}bertragen.}
}

@article{gusenbauer2020academic,
  author   = {Gusenbauer, Michael and Haddaway, Neal R.},
  title    = {Which Academic Search Systems Are Suitable for Systematic Reviews or Meta-Analyses? Evaluating Retrieval Qualities of {Google Scholar}, {PubMed}, and 26 Other Resources},
  journal  = {Research Synthesis Methods},
  volume   = {11},
  number   = {2},
  pages    = {181--217},
  year     = {2020},
  doi      = {10.1002/jrsm.1378},
  abstract = {Die Autoren pr{\"u}fen 28 akademische Suchsysteme danach, ob sie f{\"u}r systematische Recherchen taugen: ob boolesche Suchstrings korrekt verarbeitet werden, ob Ergebnisse wiederholbar sind und ob sich Treffer filtern lassen. Viele verbreitete Systeme, darunter Google Scholar, eignen sich demnach nicht als Hauptquelle einer systematischen Suche, wohl aber als Erg{\"a}nzung.}
}

@article{hasher1977frequency,
  author   = {Hasher, Lynn and Goldstein, David and Toppino, Thomas},
  title    = {Frequency and the Conference of Referential Validity},
